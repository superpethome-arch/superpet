{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(.*\\.jpg|.*\\.jpeg|.*\\.png|.*\\.webp|.*\\.gif|.*\\.svg|.*\\.ico|.*\\.woff2|.*\\.woff|.*\\.ttf|.*\\.mp4)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.html|.*\\.css|.*\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "redirects": [
    { "source": "/services", "destination": "/#services", "permanent": false },
    { "source": "/services/", "destination": "/#services", "permanent": false },
    { "source": "/grooming", "destination": "/#services", "permanent": false },
    { "source": "/grooming/", "destination": "/#services", "permanent": false },
    { "source": "/book", "destination": "/#booking", "permanent": false },
    { "source": "/book/", "destination": "/#booking", "permanent": false },
    { "source": "/booking", "destination": "/#booking", "permanent": false },
    { "source": "/booking/", "destination": "/#booking", "permanent": false },
    { "source": "/appointments", "destination": "/#booking", "permanent": false },
    { "source": "/appointments/", "destination": "/#booking", "permanent": false },
    { "source": "/contact", "destination": "/#booking", "permanent": false },
    { "source": "/contact/", "destination": "/#booking", "permanent": false },
    { "source": "/reviews", "destination": "/#testimonials", "permanent": false },
    { "source": "/reviews/", "destination": "/#testimonials", "permanent": false },
    { "source": "/testimonials", "destination": "/#testimonials", "permanent": false },
    { "source": "/testimonials/", "destination": "/#testimonials", "permanent": false },
    { "source": "/gallery", "destination": "/#gallery", "permanent": false },
    { "source": "/gallery/", "destination": "/#gallery", "permanent": false },
    { "source": "/prices", "destination": "/#services", "permanent": false },
    { "source": "/prices/", "destination": "/#services", "permanent": false },
    { "source": "/pricing", "destination": "/#services", "permanent": false },
    { "source": "/pricing/", "destination": "/#services", "permanent": false },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/payment", "destination": "/payment.html", "permanent": false },
    { "source": "/dog-grooming", "destination": "/#services", "permanent": false },
    { "source": "/dog-grooming/", "destination": "/#services", "permanent": false },
    { "source": "/cat-grooming", "destination": "/#services", "permanent": false },
    { "source": "/cat-grooming/", "destination": "/#services", "permanent": false },
    { "source": "/nail-trim", "destination": "/#services", "permanent": false },
    { "source": "/nail-trim/", "destination": "/#services", "permanent": false },
    { "source": "/spa", "destination": "/#services", "permanent": false },
    { "source": "/spa/", "destination": "/#services", "permanent": false },
    { "source": "/puppy-grooming", "destination": "/#services", "permanent": false },
    { "source": "/puppy-grooming/", "destination": "/#services", "permanent": false }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug.html" }
  ]
}
